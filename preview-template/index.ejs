<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title><%=title%></title>
    <meta
        name="viewport"
        content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true"
    />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="full-screen" content="yes" />
    <meta name="screen-orientation" content="" />
    <meta name="x5-fullscreen" content="true" />
    <meta name="360-fullscreen" content="true" />
    <meta name="x5-page-mode" content="app" />
    <meta name="renderer" content="webkit" />
    <meta name="force-rendering" content="webkit" />
    <meta name="msapplication-tap-highlight" content="no" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

    <!--
        預覽頁模板：把 cocos-creator-native 的 HTML UI 層（game-ui／ds）帶進 Creator 預覽，
        讓預覽能直接嵌進 gc0003 的 iframe 測試，不必每次 build web-mobile。
        native/ 下四個檔案複製自 tools/cocos-creator-native/v3/build-templates/web-mobile，
        該 repo 更新時需一併同步（正式 build 走 build-templates，不經本檔）。

        刻意不引 Creator 預覽專用的 index.css、也不放 cocosToolBar：
        版面與縮放要與正式版一致，設計稿比對才有意義。
        絕對路徑 /native/*：preview-template 目錄由預覽伺服器以根路徑服務。
    -->
    <link rel="stylesheet" type="text/css" href="/native/style.css" />
    <link rel="stylesheet" type="text/css" href="/native/game-ui.css" />

    <style>
        /*
            預覽工具列：Creator 的 ui.js 啟動時會查詢 .toolbar 及其子元素（#view-select、
            #btn-rotate、#opts-debug-mode…），缺任何一個就 throw「UI element ... doesn't exist」
            並中斷後續初始化。因此 DOM 照常 include，只是隱藏不顯示——iframe 內要的是純遊戲畫面。
        */
        .toolbar {
            display: none !important;
        }
    </style>
</head>
<body>
    <%
        // 覆寫 Creator 的預覽設定（~/.CocosCreator/profiles，全域共用），只影響本專案預覽頁；
        // 工具列隱藏後也無從在頁面上改，所以在這裡定死：
        //   device  預設是手機模擬（如 iPhone 12），canvas 會被固定成那個比例而不填滿容器，
        //           跟正式版（web-mobile 的 cc_exact_fit_screen，填滿視窗）對不上，
        //           塞進 0003 iframe 更明顯 → 改為網頁全螢幕。
        //   showFps 正式包本來就開著 profiler 面板，預覽比照，省得每次手動開。
        var previewConfig = Object.assign({}, config, { device: 'WebpageFullScreen', showFps: true });
    %>
    <%- include(cocosToolBar, {config: previewConfig}) %>
    <!-- 結構對齊 build-templates/web-mobile/index.ejs（含 cc_exact_fit_screen） -->
    <div id="GameDiv" cc_exact_fit_screen="true">
        <div id="Cocos3dGameContainer">
            <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="99"></canvas>
        </div>

        <!--
            以下三個節點正式版沒有，但 Creator 預覽 runtime 會去取用（取不到會報錯），
            故保留空殼並預設隱藏——沒有 index.css 的話它們會直接糊在畫面上。
            預覽期間的載入進度與錯誤請看 devtools console。
        -->
        <div id="splash" style="display: none"><div class="progress-bar stripes"><span></span></div></div>
        <div id="bulletin" style="display: none"><div id="sceneIsEmpty" class="inner"><%=tip_sceneIsEmpty%></div></div>
        <div class="error" id="error" style="display: none">
            <div class="title">Error <i>(Please open the console to see detailed errors)</i></div>
            <div class="error-main"></div>
            <div class="error-stack"></div>
        </div>
    </div>
    <div class="section"></div>

    <script src="/native/game-ui.js" charset="utf-8"></script>
    <script src="/native/ds.js" charset="utf-8"></script>

    <script>
        // ds.js 在 iframe 內會把 window.onerror 轉發給父視窗（讀 window.parent.onerror）。
        // 正式環境父子同 origin 沒問題，但預覽跑在 7456、0003 在 9000，跨 origin 讀取會被擋成
        // SecurityError——而且它發生在錯誤處理器裡，會把真正的錯誤訊息蓋掉，很難查。
        // 這裡只包一層 try/catch：同 origin 時行為不變，跨 origin 時安靜略過轉發，
        // 錯誤照樣進本頁 console。
        (function () {
            var forward = window.onerror;
            window.onerror = function (msg, url, lineNo, columnNo, error) {
                try {
                    if (forward) {
                        forward(msg, url, lineNo, columnNo, error);
                    }
                } catch (e) {
                    // 跨 origin：父視窗屬性讀不到，略過轉發
                }
            };
        })();
    </script>

    <script>
        // 讓預覽跟著視窗縮放（Creator 3.8.8 的 WebpageFullScreen 只在初始化與「切換裝置」時
        // 把模擬螢幕設成 window.innerWidth/innerHeight，之後不理會 resize，視窗縮小後畫面
        // 會被裁切而不是縮放）。切換裝置的處理器會一併更新模擬尺寸、setWindowSize 並
        // dispatch resize 給引擎，所以這裡在視窗變動時「重選一次」同一個裝置即可。
        //
        // 依賴 runtime 的 DOM：options 內 li[data-device]。Creator 改版若換掉這個結構，
        // 徵兆是縮放視窗後畫面又被裁切——屆時把下面整段拿掉、改用手動重新整理即可。
        (function () {
            // 重選會觸發 runtime 自己 dispatch 的 resize，不擋就會無限遞迴
            var syncing = false;
            window.addEventListener('resize', function () {
                if (syncing) {
                    return;
                }
                var li = document.querySelector('li[data-device="WebpageFullScreen"]');
                if (!li) {
                    return;
                }
                syncing = true;
                try {
                    li.click();
                } finally {
                    // 放到本輪事件迴圈之後才解鎖：runtime 的 resize 是同步 dispatch 的
                    setTimeout(function () { syncing = false; }, 0);
                }
            }, false);
        })();
    </script>

    <%- include(cocosTemplate, {}) %>
</body>
</html>
